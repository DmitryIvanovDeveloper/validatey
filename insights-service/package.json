{
  "name": "validatey-insights-service",
  "version": "0.1.0",
  "description": "Validatey Insights Service (research/comments/scraper/signals)",
  "type": "commonjs",
  "main": "dist/server.js",
  "scripts": {
    "predev": "kill-port 8090",
    "dev": "nodemon --exec \"ts-node --transpile-only\" src/server.ts",
    "build": "tsc",
    "vercel-build": "npm run build",
    "start": "node dist/server.js",
    "type-check": "tsc --noEmit",
    "validate:all": "npm run type-check",
    "test": "npm run build && node --test \"dist/**/*.test.js\""
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.93.3",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^4.21.2",
    "helmet": "^8.1.0",
    "inversify": "^7.9.1",
    "morgan": "^1.10.1",
    "reflect-metadata": "^0.2.2",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/morgan": "^1.9.10",
    "@types/node": "^24.3.1",
    "kill-port": "^2.0.1",
    "nodemon": "^3.1.10",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2"
  }
}
