{
  "name": "validatey-frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "predev": "kill-port 5173",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.vue",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ui": "vitest --ui",
    "test:unit": "vitest run src/**/__tests__/unit/**/*.test.ts",
    "test:integration": "vitest run src/**/__tests__/integration/**/*.test.ts",
    "test:data-flow": "vitest run src/**/__tests__/data-flow/**/*.test.ts",
    "validate:all": "npm run type-check && npm run lint && npm run test:run",
    "quality:monitor": "node scripts/quality-monitor.cjs",
    "validate:full": "node scripts/validate-all.cjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.93.3",
    "apexcharts": "^5.6.0",
    "axios": "^1.11.0",
    "chart.js": "^4.5.1",
    "inversify": "^7.9.1",
    "lucide-vue-next": "^0.563.0",
    "reflect-metadata": "^0.2.2",
    "socket.io-client": "^4.8.1",
    "vue": "^3.5.18",
    "vue-chartjs": "^5.3.3",
    "vue-router": "^4.6.3",
    "vue3-apexcharts": "^1.10.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^24.3.1",
    "@typescript-eslint/eslint-plugin": "^8.43.0",
    "@typescript-eslint/parser": "^8.43.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vitest/ui": "^2.1.8",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.35.0",
    "jsdom": "^25.0.1",
    "kill-port": "^2.0.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.13",
    "vite": "^5.4.0",
    "vitest": "^2.1.8"
  }
}
