# Supabase (required for projects, scenarios, auth)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
#
# Google OAuth redirect: in Supabase Dashboard → Authentication → URL Configuration set:
#   Site URL = your frontend (e.g. https://validatey.vercel.app)
#   Redirect URLs = add https://validatey.vercel.app/auth/callback (and http://localhost:5173/auth/callback for dev)
# Otherwise after Google login you get redirected to localhost:3000 instead of your frontend.

# Auth: frontend origin for CORS and cookies (default http://localhost:5173)
# Production (e.g. Vercel): set this on the BACKEND project so browser allows requests from frontend
# FRONTEND_ORIGIN=https://validatey.vercel.app
# Multiple origins (no spaces after comma): https://validatey.vercel.app,https://validatey-git-main-xxx.vercel.app

PORT=3000

# Scenario generation + AI Helper: use either Cerebras API key OR public proxy (key recommended).
# With key: direct https://api.cerebras.ai (reliable). Without: public proxy may return 403 (Cloudflare).
# Get key: https://inference.cerebras.ai/ or https://cloud.cerebras.ai/
CEREBRAS_API_KEY=your-cerebras-api-key
# CEREBRAS_MODEL=llama-3.3-70b

# External LLM service (used only when CEREBRAS_API_KEY is not set)
# LLM_SERVICE_URL=http://localhost:8080
